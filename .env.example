# Copy to .env.local and fill in real values. Never commit real secrets.

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Auth: use a long random hex string, e.g. `openssl rand -hex 64`.
# Avoid `$` in any value: Next.js treats `$NAME` as a variable reference and silently truncates it.
JWT_SECRET=

# Google Gemini (AI assistant)
GEMINI_API_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000

# Email notifications (lib/email.js is currently a stub that only logs)
FROM_EMAIL=noreply@legaladvisor.com
FROM_NAME=Legal Property Advisor

# Document storage (lib/storage.js is currently a stub that returns fake URLs)
STORAGE_BASE_URL=
STORAGE_BUCKET=legal-documents
